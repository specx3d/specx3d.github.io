---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import FeaturedProject from '@components/FeaturedProject.astro';
import NewsCard from '@components/NewsCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
import settings from '../content/settings/site.json';

const games = await getCollection('games');
const selected = games.find((game) => game.id === settings.featuredGame);
const featuredGame = selected || games.find((game) => game.data.featured) || games.sort((a, b) => a.data.sortOrder - b.data.sortOrder)[0];
const latestNews = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero />
  {featuredGame && <FeaturedProject game={featuredGame} />}

  <section class="shell section-space studio-tease" aria-labelledby="small-studio-title">
    <div class="studio-card" data-reveal>
      <p class="eyebrow">Built differently</p>
      <h3>Modern tools.<br />Personal worlds.</h3>
      <p>Technology helps a very small team move from an idea to a living world without losing the personality that made the idea worth pursuing.</p>
      <ol class="studio-process" aria-label="Our creative process">
        <li><span>01</span>Vision</li>
        <li><span>02</span>Prototype</li>
        <li><span>03</span>World</li>
      </ol>
    </div>
    <div class="studio-copy" data-reveal>
      <p class="eyebrow">A very small indie studio</p>
      <h2 id="small-studio-title">Small scale.<br />Clear vision.</h2>
      <p>Quiet Current Games uses modern technology to turn ambitious ideas into focused games. Staying very small lets us experiment quickly, make bold choices and keep each project close to its original vision.</p>
      <p>We care about atmosphere, expressive systems and compact places that feel alive — worlds where every road, character and unexpected detour has room to matter.</p>
      <a class="text-link" href="/studio">About the studio <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="shell section-space" aria-labelledby="latest-news-title">
    <SectionHeading eyebrow="Latest notes" title="From the dev log" intro="Short, honest updates from the workbench — progress, process and the decisions behind each world." />
    <div class:list={["news-grid", { "is-single": latestNews.length === 1 }]}>
      {latestNews.map((entry) => (
        <NewsCard slug={entry.id} title={entry.data.title} date={entry.data.date} excerpt={entry.data.excerpt} tags={entry.data.tags} />
      ))}
    </div>
  </section>

  <section class="shell section-space" aria-labelledby="more-worlds-title">
    <SectionHeading eyebrow="The wider current" title="A point of view, not a single genre" intro="Our unnamed project is where the journey begins. Future projects may change genre, place and mood, while keeping the same focus on character, freedom and memorable play." />
    <div class="worlds-strip worlds-strip-three">
      <article class="world-panel" data-reveal>
        <p class="eyebrow">01 · Scope</p>
        <h3 id="more-worlds-title">Small enough to matter.</h3>
        <p>Focused worlds give every system, place and encounter a clearer purpose.</p>
      </article>
      <article class="world-panel" data-reveal>
        <p class="eyebrow">02 · Technology</p>
        <h3>Tools serve the vision.</h3>
        <p>Modern technology lets a very small studio explore ideas that once required much larger teams.</p>
      </article>
      <article class="world-panel" data-reveal>
        <p class="eyebrow">03 · Identity</p>
        <h3>Every world finds its voice.</h3>
        <p>Different genres and moods, united by atmosphere, playful freedom and a strong sense of place.</p>
      </article>
    </div>
  </section>
</BaseLayout>
