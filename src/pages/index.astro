---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import FeaturedProject from '@components/FeaturedProject.astro';
import NewsCard from '@components/NewsCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
import settings from '../content/settings/site.json';

const games = await getCollection('games');
const selected = games.find((game) => game.id === settings.featuredGame);
const featuredGame = selected || games.find((game) => game.data.featured) || games.sort((a, b) => a.data.sortOrder - b.data.sortOrder)[0];
const latestNews = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero />
  {featuredGame && <FeaturedProject game={featuredGame} />}

  <section class="shell section-space studio-tease" aria-labelledby="solo-studio-title">
    <div class="studio-card" data-reveal>
      <p class="large-number">1</p>
      <p>One person, keeping scope close and attention on the details that make a world feel alive.</p>
    </div>
    <div class="studio-copy" data-reveal>
      <p class="eyebrow">The solo studio</p>
      <h2 id="solo-studio-title">Small team.<br />Clear intention.</h2>
      <p>Quiet Current Games is a one-person independent studio focused on compact scope, atmosphere, expressive gameplay and places that stay with you.</p>
      <a class="text-link" href="/studio">About the studio <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="shell section-space" aria-labelledby="latest-news-title">
    <SectionHeading eyebrow="Latest notes" title="From the dev log" intro="Short, honest updates from the workbench — progress, process and the decisions behind each world." />
    <div class="news-grid">
      {latestNews.map((entry) => (
        <NewsCard slug={entry.id} title={entry.data.title} date={entry.data.date} excerpt={entry.data.excerpt} tags={entry.data.tags} />
      ))}
    </div>
  </section>

  <section class="shell section-space" aria-labelledby="more-worlds-title">
    <SectionHeading eyebrow="The wider current" title="More worlds will follow" intro="Quiet Current Games is the studio, not a single setting. Different genres and different places can share the same care for compact, memorable play." />
    <div class="worlds-strip">
      <article class="world-panel" data-reveal>
        <h3 id="more-worlds-title">Different games.</h3>
        <p>Each project can find its own visual language, mechanics and mood without losing the studio’s calm, handcrafted approach.</p>
      </article>
      <article class="world-panel" data-reveal>
        <h3>The same current.</h3>
        <p>Small worlds. Big stories. A home for whatever comes next.</p>
      </article>
    </div>
  </section>
</BaseLayout>
