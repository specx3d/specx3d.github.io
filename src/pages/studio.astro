---
export const prerender = true;
import BaseLayout from '@layouts/BaseLayout.astro';
import settings from '../content/settings/site.json';
---

<BaseLayout title="Studio — Quiet Current Games" description="Meet the very small indie studio behind Quiet Current Games.">
  <header class="page-hero shell">
    <p class="eyebrow">The studio</p>
    <h1>Small scale. A bigger creative reach.</h1>
    <p>{settings.studioShortDescription}</p>
  </header>
  <section class="info-grid shell" aria-label="Studio approach">
    <article class="info-block" data-reveal>
      <h2>Vision comes first</h2>
      <p>We begin with the feeling, freedom and identity a game should have, then shape its scope around what makes that idea special.</p>
    </article>
    <article class="info-block" data-reveal>
      <h2>Modern by design</h2>
      <p>New technology helps our very small team prototype faster, explore further and bring more ambitious ideas within reach.</p>
    </article>
    <article class="info-block" data-reveal>
      <h2>Focused on character</h2>
      <p>Every tool supports the same goal: compact, expressive worlds with a distinct atmosphere and something worth remembering.</p>
    </article>
  </section>
</BaseLayout>
