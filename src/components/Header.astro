---
interface Props { currentPath: string }
const { currentPath } = Astro.props;
const links = [
  { href: '/games', label: 'Games' },
  { href: '/news', label: 'Dev Log' },
  { href: '/studio', label: 'Studio' },
  { href: '/press', label: 'Press' },
  { href: '/contact', label: 'Contact' },
];
const active = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Quiet Current Games home">
      <img src="/brand/logo-mark.png" width="1254" height="1254" alt="" />
      <span class="brand-copy">
        <span class="brand-name">Quiet Current Games</span>
        <span class="brand-tagline">Play flows further</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme" title="Switch theme. Double-click to follow the system again.">
      <span data-theme-icon aria-hidden="true">◐</span>
    </button>

    <p class="header-note">A quieter<br />brighter play.</p>

    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
